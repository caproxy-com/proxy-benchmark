    "build": "tsc -p tsconfig.json",
    "bench": "node dist/cli.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "playwright": "1.62.1" },
  "devDependencies": { "typescript": "^5.7.2", "@types/node": "^22.10.2" },
  "repository": { "type": "git", "url": "https://github.com/caproxy-com/proxy-benchmark.git" },
  "homepage": "https://caproxy.com/en/methodology/",
  "keywords": ["proxy", "proxy-test", "proxy-benchmark", "residential-proxy", "playwright"]
